# URL backend API (không có trailing slash)
# Local:   http://localhost:8080/api/v1
# Staging: https://<railway-staging-url>/api/v1
# Prod:    https://<railway-prod-url>/api/v1
VITE_API_BASE=http://localhost:8080/api/v1
